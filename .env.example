# ---- GLITCH 2026 environment ----

# Admin panel password (used to log into /admin)
ADMIN_PASSWORD=louayben2026

# Secret used to sign the admin session cookie (change in production!)
SESSION_SECRET=change-this-to-a-long-random-string

# WhatsApp number that receives orders (international format, digits only, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=213600000000

# Store contact email shown to customers
NEXT_PUBLIC_STORE_EMAIL=blouay8366@gmail.com

# ---- Optional: real SMTP email delivery for orders ----
# If these are set, orders are also emailed to ORDER_EMAIL_TO via SMTP.
# If left empty, orders are stored server-side and delivered via WhatsApp only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ORDER_EMAIL_FROM=
ORDER_EMAIL_TO=blouay8366@gmail.com
