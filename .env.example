# ---- GLITCH 2026 environment ----

# Admin panel password (used to log into /admin).
# REQUIRED in production. Choose your own strong secret — never commit the real
# value to the repository.
ADMIN_PASSWORD=choose-a-strong-password

# Secret used to sign the admin session cookie. REQUIRED in production — if it is
# not set the server falls back to a random per-boot secret (sessions won't
# survive restarts). Use a long random string.
SESSION_SECRET=change-this-to-a-long-random-string

# WhatsApp number that receives orders (international format, digits only, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=213600000000

# Store contact email shown to customers
NEXT_PUBLIC_STORE_EMAIL=blouay83666@gmail.com

# ---- Database: Supabase (recommended for production / Vercel) ----
# If these are set, all products, categories, orders and slides are stored in
# Supabase Postgres (durable). If left empty, the app falls back to the local
# data/store.json file (fine for local dev, NOT durable on serverless).
# The Vercel + Supabase integration injects these automatically.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY are also read as fallbacks.

# ---- Email delivery for orders (so every order lands in your inbox) ----
# When these are set, EVERY order (WhatsApp or Email) is emailed to ORDER_EMAIL_TO.
# If left empty, orders are only stored server-side / delivered via WhatsApp.
#
# Gmail setup: SMTP_PASS must be a Google "App Password" (16 chars, spaces
# removed), NOT your normal Gmail password. Create one at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification on).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=blouay83666@gmail.com
SMTP_PASS=your-16-char-google-app-password
ORDER_EMAIL_FROM=blouay83666@gmail.com
ORDER_EMAIL_TO=blouay83666@gmail.com
